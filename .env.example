# Configuration for Open Journal Systems (OJS) Docker Stack

# Port yang dibuka di host/server
HTTP_PORT=3200
PMA_PORT=3201

# Domain atau IP server (misal: localhost atau jurnal.domainanda.com atau IP server)
SERVERNAME=localhost

# Database Credentials
DB_NAME=ojs
DB_USER=ojs
DB_PASS=ojs_secure_pass123
DB_ROOT_PASSWORD=root_secure_pass123

# OJS Automated CLI Install (0 = web installer via browser, 1 = auto install CLI)
OJS_CLI_INSTALL=0
